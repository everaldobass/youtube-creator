{
  "name": "youtube-creator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @yt/shared build && pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @yt/shared build && pnpm -r --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @yt/shared build && pnpm -r typecheck",
    "db:migrate": "pnpm --filter @yt/api prisma:migrate",
    "db:seed": "pnpm --filter @yt/api prisma:seed",
    "db:studio": "pnpm --filter @yt/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
