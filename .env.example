# API (apps/api/.env)
PORT=3001
WEB_ORIGIN=http://localhost:3000
# SQLite no MVP. Para Supabase, troque pela URL Postgres e o provider no schema.prisma.
DATABASE_URL="file:./dev.db"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage
# Pasta da biblioteca local de músicas livres (padrão: <STORAGE_LOCAL_DIR>/musicas)
MUSIC_LIBRARY_DIR=../../storage/musicas

# Gemini (títulos, roteiro, tags, thumbnails e descrição)
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY="sua-chave-gemini-aqui"
GEMINI_MODEL_TEXT="gemini-3.5-flash"
# Modelos de imagem do Gemini (ex.: gemini-3.1-flash-image, gemini-3-pro-image).
# Modelos Imagen não funcionam em generateContent e a geração de imagem exige billing habilitado.
GEMINI_MODEL_IMAGE="gemini-3.1-flash-image"

# Fish Audio (narração/TTS)
# O texto enviado é lido literalmente: não inclua instruções de tom no roteiro.
FISH_API_KEY="sua-chave-fish-audio-aqui"
FISH_VOICE_ID="id-da-voz-no-fish-audio"
FISH_MODEL_TTS="s2.1-pro-free"

# Supabase (futuro)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
